import 'package:odroe/odroe.dart';
import 'package:odroe/router.dart';
import 'package:odroe/server.dart';

final invalidContextKey = const ContextKey<String>('client');
final invalidRouteCapability = const RouteCapability<String>('document');
final invalidRequestKey = const RequestKey<String>('user');

final stringKey = ContextKey<String>('value');
final stringCapability = RouteCapability<String>('value');
final stringRequestKey = RequestKey<String>('value');

void invalidKeyValues(ModuleRegistry registry, RequestContext context) {
  stringKey.provide(registry, 42);
  stringKey.provideFactory(registry, () => 42);
  stringCapability.attach(AppRoute<NoParams, NoSearch, NoData>(), 42);
  stringRequestKey.set(context, 42);
}
